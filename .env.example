# SQLAlchemy URL. The URL determines the dialect and driver.
DATABASE_URL=postgresql+psycopg://readonly_user:replace_me@localhost:5432/your_database

# LLM generation
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Local schema and value retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=.vector_store
SCHEMA_TOP_K=8
VALUE_TOP_K=5
VALUE_CARDINALITY_THRESHOLD=500
EXAMPLE_CANDIDATE_LIMIT=500

# Query safety and retry controls
MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Optional comma-separated allow/deny lists.
# Empty ALLOWED_SCHEMAS means the database's default schema.
ALLOWED_SCHEMAS=
EXCLUDED_TABLES=