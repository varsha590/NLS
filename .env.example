# LLM generation
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Local schema and value retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=.vector_store
SCHEMA_TOP_K=8
VALUE_TOP_K=5
VALUE_CARDINALITY_THRESHOLD=500
EXAMPLE_CANDIDATE_LIMIT=500

# Uploaded dataset registration
TENANT_ID=default
DATASET_STORAGE_PATH=datasets
MAX_UPLOAD_MB=25
SQL_PARSE_TIMEOUT_SECONDS=10
LOW_CARDINALITY_MAX=50

# Local Qdrant service
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nls_documents

# Query safety and retry controls
QUERY_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Optional comma-separated allow/deny lists.
# Empty ALLOWED_SCHEMAS means the database's default schema.
ALLOWED_SCHEMAS=
EXCLUDED_TABLES=